# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Flask secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Path to SQLite database file (default: wordle_tournament.db in the project root)
# DATABASE=/path/to/wordle_tournament.db

# SMTP — Gmail example (use an App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_SENDER=you@gmail.com
SMTP_TLS=true

# VAPID keys for Web Push notifications
# Generate once: see README for instructions
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=you@example.com

# Optional: override the Wordle puzzle epoch date (default: 2021-06-19, puzzle #0)
# WORDLE_EPOCH_DATE=2021-06-19
